# Hi file copy karun .env nav dya:  cp .env.example .env

# Articles laptop varil Claude Code (`claude` command) ne lihile jatat - API key lagat nahi.
# Pahilyanda terminal madhe ekda `claude auth login` kara.

# Optional: website cha vishay. Rikama thevla tar MPSC / sarkari bharti vapartat.
# SITE_NICHE=

# Tumchya website cha URL (shevati / nako)
WP_URL=https://mpscsuccess.com
# WordPress username
WP_USER=
# WordPress Admin -> Users -> Profile -> "Application Passwords" madhun banvlela password
WP_APP_PASSWORD=

# Optional: Claude ne category nivadli nahi tar hi vaparli jail
# WP_CATEGORY=
# Optional: Claude Code model (udaharanartha opus, sonnet). Rikama = default.
# CLAUDE_MODEL=
